{
  "name": "web",
  "version": "1.0.11",
  "private": true,
  "scripts": {
    "dev:guard": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/cleanup-dev-ports.ps1 -Target web",
    "dev:reset": "node -e \"const fs=require('fs'); ['.next','.next-dev'].forEach(dir=>fs.rmSync(dir,{ recursive:true, force:true }));\"",
    "dev": "npm run dev:guard && npm run dev:reset && node ../../scripts/dev-server.mjs web",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@react-three/fiber": "^9.8.1",
    "@tanstack/react-query": "^5.100.14",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "livekit-client": "^2.19.1",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "socket.io-client": "^4.8.3",
    "three": "^0.186.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
