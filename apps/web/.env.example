# Local development: `npm run dev` serves the website on http://127.0.0.1:3301 and points it at the dev API on
# http://127.0.0.1:4002 (see scripts/dev-server.mjs). Never use 3300 / 4001 on the production PC: those are live.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3301
# Leave NEXT_PUBLIC_API_URL unset. `npm run dev` sets it for development only; a value in this file is baked into
# production builds and breaks sign-in over the public address.
# NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
NEXUSFORGE_AGE_GATE_SECRET=

# Desktop-only launch gate.
# true  -> block browser/mobile web access and allow desktop app only
# false -> allow standard web/mobile access
NEXUSFORGE_DESKTOP_ONLY=false
# Public address of uploaded files once they live in Cloudflare R2 (leave empty for local uploads).
NEXT_PUBLIC_UPLOADS_BASE_URL=
